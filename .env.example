TELEGRAM_BOT_USERNAME=

# Airtable
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Invoices

# Consultas y gráficos (execute_js). Token de solo lectura:
# data.records:read + schema.bases:read. Si falta, se usa AIRTABLE_API_KEY.
AIRTABLE_READ_API_KEY=
# Opcional: otra base, allow-list de tablas (separadas por coma) y tope por lectura.
AIRTABLE_ANALYTICS_BASE_ID=
AIRTABLE_ANALYTICS_TABLES=
AIRTABLE_ANALYTICS_MAX_RECORDS=20000
# Límites por ejecución de código (JavaScript en QuickJS)
CODEACT_TIMEOUT_MS=30000
CODEACT_MEMORY_MB=256

# LlamaParse
LLAMA_CLOUD_API_KEY=

# Model (eve link puede configurar AI_GATEWAY_API_KEY automáticamente)
AI_GATEWAY_API_KEY=
INVOICE_EXTRACTION_MODEL=openai/gpt-5.6-luna

# Web Chat (HTTP Basic en producción)
FACTURAS_WEB_USERNAME=
FACTURAS_WEB_PASSWORD=
